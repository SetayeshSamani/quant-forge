# Backend only. Copy locally to .env; never put credentials in VITE_* or Git.
# Precedence: process environment > .env > safe defaults. Restart to reload.
BOXAPI_API_KEY=
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
BOXAPI_MODEL=gpt-5.4-mini
WALLEX_API_KEY=
WALLEX_SYMBOL=BTCTMN
WALLEX_ACCOUNT_TYPE=prop
# Explicit verified hackathon account; never falls back to the main account.
WALLEX_SUBACCOUNT_ID=
TRADING_MODE=SHADOW
LIVE_TRADING_ENABLED=false
APP_ENV=local
# Blank reuses LocalAppData/QuantForge/release-native-qa/data on Windows.
DATA_DIR=
BACKEND_PORT=8080
